# Server port
PORT=4000

# Secret used to sign JWT access tokens. Set your own value; never commit .env.
JWT_SECRET=replace-with-a-long-random-string

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data/kickvault.db

# Shared secret for the mock stock sync endpoint (POST /cron/sync,
# header: x-cron-secret). Set your own value.
CRON_SECRET=replace-with-a-shared-cron-secret

# Deployment only (leave unset for local development):
# CORS_ORIGIN=https://your-frontend.vercel.app   allowed browser origin
# TRUST_PROXY=1                                  reverse proxies in front (Render: 1)